# ==========================================================
# منصة رِفاد للمتابعة والجودة المدرسية — نموذج متغيرات البيئة
# ----------------------------------------------------------
# انسخ هذا الملف إلى .env ثم عدّل القيم:
#     cp .env.example .env
#
# ⚠️ لا تضع أي سرّ حقيقي في هذا الملف ولا في الكود المصدري.
# ⚠️ ملف .env مستثنى من Git ولا يُرفع إلى المستودع.
# ==========================================================

# --- الأسرار (إلزامية) -------------------------------------
# سلسلة عشوائية قوية لا تقل عن 32 حرفاً. ولّدها بالأمر:
#     openssl rand -hex 32
# ⛔ لا تشغّل المنصة بهذه القيمة — الخادم يرفض القيم النائبة.
#    استبدلها بناتج openssl rand -hex 32 (64 حرفاً) قبل التشغيل.
JWT_SECRET=""
# اختياري: سرّ منفصل لرموز التجديد. إن تُرك فارغاً يُستخدم JWT_SECRET.
JWT_REFRESH_SECRET=""

# --- صلاحية الجلسات ----------------------------------------
JWT_ACCESS_TTL_MINUTES="60"
JWT_REFRESH_TTL_DAYS="7"

# --- قاعدة البيانات (SQLite) -------------------------------
# المجلد الذي تُحفظ فيه قاعدة البيانات. الافتراضي: جذر المشروع.
SQLITE_DIR="./"
# اسم ملف قاعدة البيانات.
DATABASE_FILE="dev.db"

# --- التطبيق -----------------------------------------------
# العنوان العام للمنصة، يُستخدم في الميتاداتا وروابط التحقق.
APP_URL="http://localhost:3000"
