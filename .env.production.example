# ==========================================================
# منصة رِفاد — متغيرات بيئة الإنتاج
# ----------------------------------------------------------
# انسخ هذا الملف إلى .env.production ثم عدّل القيم:
#     cp .env.production.example .env.production
#     chmod 600 .env.production
#
# ⚠️ لا تُرفع هذا الملف إلى Git. الملف الفعلي مستثنى تلقائياً.
# ==========================================================

# --- الأسرار (إلزامية — ولّدها الآن) -----------------------
#     openssl rand -hex 32
JWT_SECRET="استبدل-هذه-القيمة-بسلسلة-عشوائية-64-حرفاً"

# اختياري: سرّ منفصل لرموز التجديد.
#     openssl rand -hex 32
JWT_REFRESH_SECRET=""

# --- صلاحية الجلسات ----------------------------------------
JWT_ACCESS_TTL_MINUTES="60"
JWT_REFRESH_TTL_DAYS="7"

# --- التطبيق -----------------------------------------------
# العنوان العام الذي يفتحه المستخدمون — ضع IP الخادم أو النطاق.
# أمثلة:
#   APP_URL="http://203.0.113.10"
#   APP_URL="https://rifad.example.edu.ye"
APP_URL="http://CHANGE-ME"

# --- قاعدة البيانات ----------------------------------------
# داخل Docker يُضبط تلقائياً على /app/data — لا تغيّره.
SQLITE_DIR="/app/data"
DATABASE_FILE="rifad.db"
